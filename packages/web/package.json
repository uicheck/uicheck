{
  "name": "@uicheck/web",
  "version": "0.1.7",
  "description": "Browser DOM client for uicheck",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./cdn": {
      "import": "./dist/cdn.js",
      "types": "./dist/cdn.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node scripts/cdn-dev.mjs",
    "dev:cdn": "node scripts/cdn-dev.mjs",
    "build": "pnpm run build:lib && pnpm run build:cdn",
    "build:lib": "tsup",
    "build:cdn": "node scripts/cdn-dev.mjs --once",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ui-check",
    "browser",
    "dom",
    "mcp"
  ],
  "license": "MIT",
  "dependencies": {
    "@uicheck/core": "workspace:*",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@uicheck/mcp": "workspace:*",
    "esbuild": "^0.27.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.6",
    "ws": "^8.20.1"
  }
}

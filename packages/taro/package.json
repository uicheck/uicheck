{
  "name": "@uicheck/taro",
  "version": "0.1.5",
  "description": "Taro Mini Program client for uicheck",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.snapshot.test.ts'",
    "test:weapp-snapshot": "vitest run src/taro-weapp.snapshot.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ui-check",
    "taro",
    "mini-program"
  ],
  "license": "MIT",
  "dependencies": {
    "@uicheck/core": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.0.0",
    "@uicheck/mcp": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.6"
  }
}
